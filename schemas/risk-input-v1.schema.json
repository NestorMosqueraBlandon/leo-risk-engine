  "description": "Canonical entry contract for Leo Risk Engine.\n\nRepresents everything the engine can know about a student at a\nspecific point in time. External systems must normalize their data\nto this contract before it enters the engine.\n\nThe engine does NOT depend on leoApi or any specific SIS. Any\nproducer capable of generating a valid RiskInput can use the engine.",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "description": "Schema version. Increment major for breaking changes, minor for backward-compatible additions.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "as_of": {
      "description": "The exact moment up to which information may be used. No observation with available_at > as_of is permitted.",
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "student_id": {
      "minLength": 1,
      "title": "Student Id",
      "type": "string"
    },
    "institution_id": {
      "minLength": 1,
      "title": "Institution Id",
      "type": "string"
    },
    "academic_program_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Program the student is enrolled in.",
      "title": "Academic Program Id"
    },
    "academic_period_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Current academic period.",
      "title": "Academic Period Id"
    },
    "academic": {
      "$ref": "#/$defs/AcademicBlock"
    },
    "attendance": {
      "$ref": "#/$defs/AttendanceBlock"
    },
    "financial": {
      "anyOf": [
        {
          "$ref": "#/$defs/FinancialBlock"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Financial data. None if not available from this institution."
    },
    "engagement": {
      "anyOf": [
        {
          "$ref": "#/$defs/EngagementBlock"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Engagement events. None if not available."
    },
    "supports": {
      "anyOf": [
        {
          "$ref": "#/$defs/SupportsBlock"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Support services. None if not available."
    },
    "interventions": {
      "anyOf": [
        {
          "$ref": "#/$defs/InterventionsBlock"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Intervention history. None if not available."
    },
    "institutional_context": {
      "$ref": "#/$defs/InstitutionalContext"
    },
    "available_sources": {
      "description": "Which data sources are available for this student. Critical for missing data policy.",
      "items": {
        "$ref": "#/$defs/SourceAvailability"
      },
      "title": "Available Sources",
      "type": "array"
    },
    "extensions": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "description": "Namespaced extensions for country/institution-specific data. Keys must be namespaced (e.g., 'co.education', 'us.collegeboard'). Values are validated dictionaries.",
      "title": "Extensions",
      "type": "object"
    }
  },
  "required": [
    "as_of",
    "student_id",
    "institution_id"
  ],
  "title": "RiskInput",
  "type": "object"
}
